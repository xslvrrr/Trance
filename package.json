{
  "name": "trance-desktop",
  "version": "0.2.1",
  "description": "",
  "lint-staged": {
    "**/*": ""
  },
  "type": "module",
  "scripts": {
    "build": "surfer build",
    "build:ui": "surfer build --ui",
    "start": "cd engine && python3 ./mach run --noprofile",
    "start:bloat": "XPCOM_MEM_BLOAT_LOG=1 npm start",
    "import": "npm run ffprefs && npm run import:dumps && surfer import && npm run locales && npm run patches:relink && npm run patches:check && npm run patches:verify && npm run inventory:check",
    "import:dumps": "python3 scripts/update_service_dumps.py",
    "patches": "python3 scripts/trance-patches.py",
    "patches:manifest": "python3 scripts/trance-patches.py manifest",
    "patches:check": "python3 scripts/trance-patches.py manifest --check",
    "patches:verify": "python3 scripts/trance-patches.py verify",
    "patches:relink": "python3 scripts/trance-patches.py relink",
    "patches:overlaps": "python3 scripts/trance-patches.py overlaps",
    "inventory:check": "python3 scripts/trance-inventory.py check",
    "locales": "python3 scripts/copy_language_pack.py en-US",
    "export": "surfer export",
    "init": "npm run download && npm run import && npm run bootstrap",
    "download": "surfer download",
    "bootstrap": "surfer bootstrap",
    "package": "npm run provision && surfer package",
    "provision": "python3 scripts/trance-cosine.py --for-package",
    "sync": "python3 scripts/update_ff.py",
    "sync:raw": "surfer update",
    "sync:rc": "python3 scripts/update_ff.py --rc",
    "sync:l10n": "python3 scripts/update_ff.py --just-l10n",
    "lint": "cd engine && ./mach lint zen",
    "lint:fix": "npm run lint -- --fix",
    "reset-ff": "surfer reset",
    "surfer": "surfer",
    "test": "python3 scripts/run_tests.py",
    "test:unit": "node --experimental-vm-modules --test src/zen/trance/tests/*.test.mjs",
    "test:dbg": "python3 scripts/run_tests.py --jsdebugger --debug-on-failure",
    "test:gtest": "cd engine && ./mach gtest Zen*",
    "ffprefs": "cd tools/ffprefs && cargo run --bin ffprefs -- ../../",
    "lc": "surfer license-check",
    "lc:fix": "surfer license-check --fix",
    "use-moz-src": "cd engine && ./mach use-moz-src",
    "ci": "surfer ci --brand trance --display-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xslvrrr/Trance.git"
  },
  "keywords": [],
  "author": "",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/xslvrrr/Trance/issues"
  },
  "homepage": "https://github.com/xslvrrr/Trance#readme",
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.0",
    "@zen-browser/prettier": "^3.9.3",
    "@zen-browser/surfer": "^1.14.9",
    "formal-git": "^1.2.9",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "typescript": "^5.9.3"
  },
  "notes(private)": "We don't want to publish to npm, so this is marked as private",
  "private": true
}
