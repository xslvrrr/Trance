index 3ea3d88b93604f09067acbc4d26be5e8d4fda91b..cc5d040950f14393518f89208dfc4cf42cfb43f8 100644
--- a/browser/moz.configure
+++ b/browser/moz.configure
@@ -11,7 +11,13 @@ imply_option("MOZ_NORMANDY", True)
 imply_option("MOZ_PROFILE_MIGRATOR", True)
 
 
-imply_option("MOZ_APP_VENDOR", "Mozilla")
+# >>> TRANCE
+# `imply_option` beats the default in toolkit/moz.configure, so setting
+# MOZ_APP_VENDOR there has no effect while this line says Mozilla. It reaches
+# application.ini's Vendor field, the crash-reporter product, and the Windows
+# profile/registry hierarchy. TRANCE.md §7.4 requires Trance to own it.
+imply_option("MOZ_APP_VENDOR", "Trance")
+# <<< TRANCE
 imply_option("MOZ_APP_ID", "{ec8030f7-c20a-464f-9b0e-13a3a9e97384}")
 # Include the DevTools client, not just the server (which is the default)
 imply_option("MOZ_DEVTOOLS", "all")
