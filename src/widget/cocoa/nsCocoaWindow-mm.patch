+@interface ZenWindowMaterialView : NSVisualEffectView
+- (void)prefChanged;
+- (void)windowActivityChanged:(NSNotification*)aNotification;
+@end
+
+// >>> TRANCE
+// The material is a continuous compositor effect: macOS keeps resolving it for
+// a window that is minimised, fully occluded or behind another application,
+// and for a machine in Low Power Mode that is work nobody asked for. AppKit
+// exposes the switch as NSVisualEffectStateInactive, which stops the effect
+// without taking the view down and without a relayout when it comes back.
+//
+// The power-mode half is a process-wide fact, so it is mirrored into a default
+// -branch pref rather than read per view: one notification observer for the
+// process, and the existing pref-callback path is what wakes every live view.
+static constexpr const char* kZenLowPowerModePref =
+    "zen.performance.low-power-mode";
+
+static void ZenUpdateLowPowerModePref() {
+  bool enabled = false;
+  if (@available(macOS 12.0, *)) {
+    enabled = NSProcessInfo.processInfo.lowPowerModeEnabled;
+  }
+  Preferences::SetBool(kZenLowPowerModePref, enabled, PrefValueKind::Default);
+}
+
+@interface ZenPowerModeMonitor : NSObject
++ (void)start;
+@end
+
+@implementation ZenPowerModeMonitor
++ (void)start {
+  static ZenPowerModeMonitor* monitor;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    monitor = [[ZenPowerModeMonitor alloc] init];
+  });
+}
+
+- (instancetype)init {
+  self = [super init];
+  if (self) {
+    ZenUpdateLowPowerModePref();
+    if (@available(macOS 12.0, *)) {
+      [NSNotificationCenter.defaultCenter
+          addObserver:self
+             selector:@selector(powerModeChanged:)
+                 name:NSProcessInfoPowerStateDidChangeNotification
+               object:nil];
+    }
+  }
+  return self;
+}
+
+- (void)powerModeChanged:(NSNotification*)aNotification {
+  (void)aNotification;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    ZenUpdateLowPowerModePref();
+  });
+}
+@end
+// <<< TRANCE
+
+static void ZenWindowMaterialPrefChanged(const char* aPref, void* aClosure) {
+  [static_cast<ZenWindowMaterialView*>(aClosure) prefChanged];
+}
+
+static constexpr nsLiteralCString kZenWindowMaterialPrefs[] = {
+    "zen.widget.macos.window-material"_ns,
+    "zen.view.grey-out-inactive-windows"_ns,
+    // >>> TRANCE
+    "zen.performance.low-power-mode"_ns,
+    // <<< TRANCE
+};
+
+static NSVisualEffectMaterial ZenWindowMaterial() {
+  switch (StaticPrefs::zen_widget_macos_window_material()) {
+    case 1:
+      return NSVisualEffectMaterialHUDWindow;
+    case 2:
+      return NSVisualEffectMaterialFullScreenUI;
+    case 3:
+      return NSVisualEffectMaterialPopover;
+    case 4:
+      return NSVisualEffectMaterialMenu;
+    case 5:
+      return NSVisualEffectMaterialToolTip;
+    case 6:
+      return NSVisualEffectMaterialHeaderView;
+    case 7:
+    default:
+      return NSVisualEffectMaterialUnderWindowBackground;
+  }
+}
+
+@implementation ZenWindowMaterialView
+- (instancetype)initWithFrame:(NSRect)aRect {
+  self = [super initWithFrame:aRect];
+  self.appearance = nil;
+  self.emphasized = NO;
+  self.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+  // >>> TRANCE
+  for (NSNotificationName name in @[
+         NSWindowDidChangeOcclusionStateNotification,
+         NSWindowDidMiniaturizeNotification,
+         NSWindowDidDeminiaturizeNotification,
+       ]) {
+    [NSNotificationCenter.defaultCenter addObserver:self
+                                           selector:@selector
+                                           (windowActivityChanged:)
+                                               name:name
+                                             object:nil];
+  }
+  // <<< TRANCE
+  [self prefChanged];
+  for (const auto& pref : kZenWindowMaterialPrefs) {
+    Preferences::RegisterCallback(ZenWindowMaterialPrefChanged, pref, self);
+  }
+  return self;
+}
+
+- (void)dealloc {
+  // >>> TRANCE
+  [NSNotificationCenter.defaultCenter removeObserver:self];
+  // <<< TRANCE
+  for (const auto& pref : kZenWindowMaterialPrefs) {
+    Preferences::UnregisterCallback(ZenWindowMaterialPrefChanged, pref, self);
+  }
+  [super dealloc];
+}
+
+- (void)prefChanged {
+  self.material = ZenWindowMaterial();
+  // >>> TRANCE
+  [self windowActivityChanged:nil];
+}
+
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  [self windowActivityChanged:nil];
+}
+
+- (void)windowActivityChanged:(NSNotification*)aNotification {
+  if (aNotification && aNotification.object != self.window) {
+    return;
+  }
+  NSWindow* window = self.window;
+  bool visible = window && !window.miniaturized &&
+                 (window.occlusionState & NSWindowOcclusionStateVisible);
+  if (!visible || Preferences::GetBool(kZenLowPowerModePref, false)) {
+    self.state = NSVisualEffectStateInactive;
+    return;
+  }
+  // <<< TRANCE
+  self.state = StaticPrefs::zen_view_grey_out_inactive_windows()
+                   ? NSVisualEffectStateFollowsWindowActiveState
+                   : NSVisualEffectStateActive;
+}
+@end
+
+static void ZenWindowVibrancyPrefChanged(const char* aPref, void* aClosure) {
+  static_cast<nsCocoaWindow*>(aClosure)->UpdateWindowMaterial();
+}
+
+void nsCocoaWindow::SetWindowClass(const nsAString& aXulWinType,
+                                   const nsAString& aXulWinClass,
+                                   const nsAString& aXulWinName) {
+  if (mWindowType != WindowType::TopLevel || mIsBrowserWindow ||
+      !aXulWinType.EqualsLiteral("navigator:browser")) {
+    return;
+  }
+  mIsBrowserWindow = true;
+  // >>> TRANCE
+  [ZenPowerModeMonitor start];
+  // <<< TRANCE
+  Preferences::RegisterCallback(ZenWindowVibrancyPrefChanged,
+                                "zen.widget.macos.window-vibrancy", this);
+  UpdateWindowMaterial();
+}
+
+void nsCocoaWindow::UpdateWindowMaterial() {
+  NS_OBJC_BEGIN_TRY_IGNORE_BLOCK;
+
+  if (!mWindow) {
+    return;
+  }
+  bool wanted = StaticPrefs::zen_widget_macos_window_vibrancy();
+  if (wanted ==
+      [mWindow.contentView isKindOfClass:[ZenWindowMaterialView class]]) {
+    return;
+  }
+
+  NSRect frame = mWindow.contentView.frame;
+  NSView* wrapper = wanted ? [[ZenWindowMaterialView alloc] initWithFrame:frame]
+                           : [[NSView alloc] initWithFrame:frame];
+  wrapper.wantsLayer = YES;
+  for (NSView* view in [mWindow contentViewContents]) {
+    [view removeFromSuperviewWithoutNeedingDisplay];
+    [wrapper addSubview:view];
+  }
+  mWindow.contentView = wrapper;
+  [wrapper release];
+
+  NS_OBJC_END_TRY_IGNORE_BLOCK;
+}
