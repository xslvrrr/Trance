+void nsCocoaWindow::UpdateWindowMaterial() {
+  NS_OBJC_BEGIN_TRY_IGNORE_BLOCK;
+
+  if (!mWindow) {
+    return;
+  }
+  bool wanted = StaticPrefs::zen_widget_macos_window_vibrancy();
+  // >>> TRANCE
+  // A published radius replaces the material with the radius-driven wrapper;
+  // without one this is Zen's choice between material and plain, unchanged.
+  bool blur = wanted && ZenWindowBlurRadius() >= 0;
+  bool material = wanted && !blur;
+  NSView* current = mWindow.contentView;
+  if (material == [current isKindOfClass:[ZenWindowMaterialView class]] &&
+      blur == [current isKindOfClass:[ZenWindowBlurView class]]) {
+    return;
+  }
+
+  NSRect frame = current.frame;
+  NSView* wrapper = material
+                        ? [[ZenWindowMaterialView alloc] initWithFrame:frame]
+                    : blur ? [[ZenWindowBlurView alloc] initWithFrame:frame]
+                           : [[NSView alloc] initWithFrame:frame];
+  // <<< TRANCE
+  wrapper.wantsLayer = YES;
+  for (NSView* view in [mWindow contentViewContents]) {
+    [view removeFromSuperviewWithoutNeedingDisplay];
+    [wrapper addSubview:view];
+  }
+  mWindow.contentView = wrapper;
+  [wrapper release];
+
+  NS_OBJC_END_TRY_IGNORE_BLOCK;
+}
