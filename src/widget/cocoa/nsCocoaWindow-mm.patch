+// >>> TRANCE
+// The window's own blur, with a radius.
+//
+// ZenWindowMaterialView is an NSVisualEffectView, and AppKit fixes the blur of
+// a material: there is no radius to ask for, so Trance's blur control reached
+// every surface except the one a person actually looks through — the desktop
+// behind the window. The window server does blur a window's background by a
+// radius (CGSSetWindowBackgroundBlurRadius, the call terminals use for the
+// same control), so when Trance publishes a radius the material view is
+// replaced by this plain wrapper and the radius is applied to the window.
+//
+// -1 is "no radius published": Zen's material, exactly as before.
+//
+// A browser window is created opaque ("non-popup windows are always opaque"),
+// and the material never needed otherwise: an NSVisualEffectView blending
+// behind the window shows through an opaque window by itself. A window-server
+// background blur does not — it blurs what is behind a window's *transparent*
+// pixels, and an opaque window has none, so it would paint the window's own
+// background colour. This view therefore makes its window non-opaque with a
+// clear background while it is the content view, and puts both back when it
+// leaves; SetTransparencyMode keeps it that way for as long as it is there.
+//
+// The call is private, so it is looked up at runtime like the Spaces functions
+// further down, and a missing symbol leaves an unblurred window rather than a
+// crash.
+static constexpr char kZenWindowBlurRadiusPref[] =
+    "zen.widget.macos.window-blur-radius";
+
+static int32_t ZenWindowBlurRadius() {
+  return Preferences::GetInt(kZenWindowBlurRadiusPref, -1);
+}
+
+typedef CGError (*CGSSetWindowBackgroundBlurRadiusFunc)(CGSConnection cid,
+                                                        CGSWindow wid,
+                                                        NSUInteger radius);
+static CGSSetWindowBackgroundBlurRadiusFunc
+GetCGSSetWindowBackgroundBlurRadiusFunc() {
+  static CGSSetWindowBackgroundBlurRadiusFunc func = nullptr;
+  static bool lookedUpFunc = false;
+  if (!lookedUpFunc) {
+    func = (CGSSetWindowBackgroundBlurRadiusFunc)dlsym(
+        RTLD_DEFAULT, "CGSSetWindowBackgroundBlurRadius");
+    lookedUpFunc = true;
+  }
+  return func;
+}
+
+@interface ZenWindowBlurView : NSView {
+  NSInteger mAppliedWindowNumber;
+  int32_t mAppliedRadius;
+  // What the window was before this view made it see-through, so leaving
+  // gives exactly that back rather than a guess.
+  BOOL mRestoreOpaque;
+  NSColor* mRestoreBackground;
+}
+- (void)applyBlur;
+- (void)windowDidOrderIn;
+- (void)windowActivityChanged:(NSNotification*)aNotification;
+@end
+
+static void ZenWindowBlurPrefChanged(const char* aPref, void* aClosure) {
+  [static_cast<ZenWindowBlurView*>(aClosure) applyBlur];
+}
+
+static constexpr nsLiteralCString kZenWindowBlurPrefs[] = {
+    "zen.widget.macos.window-blur-radius"_ns,
+    "zen.performance.low-power-mode"_ns,
+};
+
+static void ZenSetWindowBackgroundBlurRadius(NSWindow* aWindow,
+                                             int32_t aRadius) {
+  CGSSetWindowBackgroundBlurRadiusFunc func =
+      GetCGSSetWindowBackgroundBlurRadiusFunc();
+  if (!func || !aWindow || aWindow.windowNumber <= 0) {
+    return;
+  }
+  func(_CGSDefaultConnection(), aWindow.windowNumber,
+       static_cast<NSUInteger>(std::max(aRadius, 0)));
+}
+
+@implementation ZenWindowBlurView
+- (instancetype)initWithFrame:(NSRect)aRect {
+  self = [super initWithFrame:aRect];
+  if (self) {
+    mAppliedWindowNumber = -1;
+    mAppliedRadius = -1;
+    // A window created with defer:YES has no window device, and so no window
+    // number, until it is first shown; nsCocoaWindow::Show calls
+    // -windowDidOrderIn once it has one. Occlusion changes re-send the radius
+    // after a move between Spaces or a trip through full screen.
+    [NSNotificationCenter.defaultCenter
+        addObserver:self
+           selector:@selector(windowActivityChanged:)
+               name:NSWindowDidChangeOcclusionStateNotification
+             object:nil];
+    for (const auto& pref : kZenWindowBlurPrefs) {
+      Preferences::RegisterCallback(ZenWindowBlurPrefChanged, pref, self);
+    }
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [NSNotificationCenter.defaultCenter removeObserver:self];
+  for (const auto& pref : kZenWindowBlurPrefs) {
+    Preferences::UnregisterCallback(ZenWindowBlurPrefChanged, pref, self);
+  }
+  [mRestoreBackground release];
+  [super dealloc];
+}
+
+- (void)viewWillMoveToWindow:(NSWindow*)aWindow {
+  // Leaving the window — the material view is taking over, or the window is
+  // going away. The radius and the transparency belong to the window rather
+  // than to this view, so both have to be handed back explicitly or they
+  // would outlive the choice.
+  NSWindow* window = self.window;
+  if (window && aWindow != window) {
+    ZenSetWindowBackgroundBlurRadius(window, 0);
+    mAppliedWindowNumber = -1;
+    mAppliedRadius = -1;
+    if (mRestoreBackground) {
+      window.backgroundColor = mRestoreBackground;
+      window.opaque = mRestoreOpaque;
+      [mRestoreBackground release];
+      mRestoreBackground = nil;
+    }
+  }
+  [super viewWillMoveToWindow:aWindow];
+}
+
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  NSWindow* window = self.window;
+  if (window && !mRestoreBackground) {
+    mRestoreOpaque = window.opaque;
+    mRestoreBackground =
+        [(window.backgroundColor ?: NSColor.windowBackgroundColor) retain];
+    window.opaque = NO;
+    window.backgroundColor = NSColor.clearColor;
+  }
+  [self applyBlur];
+}
+
+- (void)windowDidOrderIn {
+  // Re-send even if the cache says this radius is already on this window: the
+  // window server is the authority on what the window carries, and this runs
+  // once per show.
+  mAppliedRadius = -1;
+  [self applyBlur];
+}
+
+- (void)windowActivityChanged:(NSNotification*)aNotification {
+  if (aNotification.object != self.window) {
+    return;
+  }
+  [self windowDidOrderIn];
+}
+
+- (void)applyBlur {
+  NSWindow* window = self.window;
+  if (!window || window.windowNumber <= 0) {
+    return;
+  }
+  // Low Power Mode stops the material for the same reason: the window server
+  // resolves a background blur continuously, and that is work nobody asked
+  // for on a machine trying to save power.
+  int32_t radius = Preferences::GetBool(kZenLowPowerModePref, false)
+                       ? 0
+                       : std::max(ZenWindowBlurRadius(), 0);
+  if (window.windowNumber == mAppliedWindowNumber && radius == mAppliedRadius) {
+    return;
+  }
+  ZenSetWindowBackgroundBlurRadius(window, radius);
+  mAppliedWindowNumber = window.windowNumber;
+  mAppliedRadius = radius;
+}
+@end
+// <<< TRANCE
