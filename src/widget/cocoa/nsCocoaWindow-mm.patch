+@implementation ZenWindowMaterialView
+- (instancetype)initWithFrame:(NSRect)aRect {
+  self = [super initWithFrame:aRect];
+  self.appearance = nil;
+  self.emphasized = NO;
+  self.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+  // >>> TRANCE
+  for (NSNotificationName name in @[
+         NSWindowDidChangeOcclusionStateNotification,
+         NSWindowDidMiniaturizeNotification,
+         NSWindowDidDeminiaturizeNotification,
+       ]) {
+    [NSNotificationCenter.defaultCenter addObserver:self
+                                           selector:@selector
+                                           (windowActivityChanged:)
+                                               name:name
+                                             object:nil];
+  }
+  // <<< TRANCE
+  [self prefChanged];
+  for (const auto& pref : kZenWindowMaterialPrefs) {
+    Preferences::RegisterCallback(ZenWindowMaterialPrefChanged, pref, self);
+  }
+  return self;
+}
+
+- (void)dealloc {
+  // >>> TRANCE
+  [NSNotificationCenter.defaultCenter removeObserver:self];
+  [mMaterialBlurRadius release];
+  // <<< TRANCE
+  for (const auto& pref : kZenWindowMaterialPrefs) {
+    Preferences::UnregisterCallback(ZenWindowMaterialPrefChanged, pref, self);
+  }
+  [super dealloc];
+}
+
+- (void)prefChanged {
+  self.material = ZenWindowMaterial();
+  // >>> TRANCE
+  [self windowActivityChanged:nil];
+  [self applyBlurRadius];
+}
+
+- (void)layout {
+  [super layout];
+  [self applyBlurRadius];
+}
+
+- (void)updateLayer {
+  [super updateLayer];
+  [self applyBlurRadius];
+}
+
+- (void)applyBlurRadius {
+  NS_OBJC_BEGIN_TRY_IGNORE_BLOCK;
+  int32_t radius = ZenWindowBlurRadius();
+  if (radius < 0 && !mMaterialBlurRadius) {
+    // Never overridden, so there is nothing to give back.
+    return;
+  }
+  NSMutableSet* skip = [NSMutableSet set];
+  for (NSView* subview in self.subviews) {
+    if (subview.layer) {
+      [skip addObject:subview.layer];
+    }
+  }
+  ZenApplyBackdropBlurRadius(self.layer, skip, radius, &mMaterialBlurRadius,
+                             0);
+  NS_OBJC_END_TRY_IGNORE_BLOCK;
+}
+
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  [self windowActivityChanged:nil];
+}
+
+- (void)windowActivityChanged:(NSNotification*)aNotification {
+  if (aNotification && aNotification.object != self.window) {
+    return;
+  }
+  NSWindow* window = self.window;
+  bool visible = window && !window.miniaturized &&
+                 (window.occlusionState & NSWindowOcclusionStateVisible);
+  if (!visible || Preferences::GetBool(kZenLowPowerModePref, false)) {
+    self.state = NSVisualEffectStateInactive;
+    return;
+  }
+  // <<< TRANCE
+  self.state = StaticPrefs::zen_view_grey_out_inactive_windows()
+                   ? NSVisualEffectStateFollowsWindowActiveState
+                   : NSVisualEffectStateActive;
+}
+@end
+
+static void ZenWindowVibrancyPrefChanged(const char* aPref, void* aClosure) {
+  static_cast<nsCocoaWindow*>(aClosure)->UpdateWindowMaterial();
+}
