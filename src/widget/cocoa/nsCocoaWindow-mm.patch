+// >>> TRANCE
+// The material's blur, with a radius (ADR-107, superseding the window-server
+// blur of ADR-099).
+//
+// AppKit fixes the blur of a material and offers no radius. The material is
+// drawn by a private CABackdropLayer inside this view, though, and that
+// layer's `gaussianBlur` filter has one: `inputRadius`. So the radius Trance
+// publishes in `zen.widget.macos.window-blur-radius` is written there, and -1
+// ("no radius published") gives the material its own value back.
+//
+// ADR-099 reached the same control with CGSSetWindowBackgroundBlurRadius, and
+// that had two costs this does not. A window-server background blur only
+// blurs a window's *transparent* pixels, so the window had to become
+// non-opaque with a clear background: the window server then composites the
+// whole window with alpha over whatever is behind it on every frame that
+// changes — measured at +100 to +190 ms of WindowServer GPU time per second
+// over a video wallpaper for a 1400x880 window, the same at radius 0 as at 60
+// — and the window's shape became its rectangle, which squared off the rounded
+// corners the moment a radius was published. The material keeps the window
+// opaque, its backdrop is sampled at an eighth of the resolution, and AppKit
+// keeps its corner mask.
+//
+// AppKit rebuilds the backdrop layer and its filters whenever the state,
+// material, appearance or key status changes, and it does that from -layout
+// and -updateLayer, so the radius is re-applied after `super` in both. Only
+// this view's own layers are walked — never the Gecko child view's — and every
+// private name is looked up at runtime and checked, so a macOS that renames
+// them leaves the material's own blur rather than a crash.
+static int32_t ZenWindowBlurRadius() {
+  return Preferences::GetInt("zen.widget.macos.window-blur-radius", -1);
+}
+
+@interface ZenWindowMaterialView () {
+  // The material's own radius, captured before the first override, so that
+  // -1 can give it back without rebuilding the view.
+  NSNumber* mMaterialBlurRadius;
+}
+- (void)applyBlurRadius;
+@end
+
+static void ZenApplyBackdropBlurRadius(CALayer* aLayer, NSSet* aSkip,
+                                       int32_t aRadius, NSNumber** aOriginal,
+                                       uint32_t aDepth) {
+  static Class sBackdropClass = NSClassFromString(@"CABackdropLayer");
+  static Class sFilterClass = NSClassFromString(@"CAFilter");
+  if (!aLayer || !sBackdropClass || !sFilterClass || aDepth > 3 ||
+      [aSkip containsObject:aLayer]) {
+    return;
+  }
+  if ([aLayer isKindOfClass:sBackdropClass]) {
+    NSArray* filters = aLayer.filters;
+    bool changed = false;
+    for (id filter in filters) {
+      if (![filter isKindOfClass:sFilterClass] ||
+          ![[filter valueForKey:@"name"] isEqual:@"gaussianBlur"]) {
+        continue;
+      }
+      NSNumber* current = [filter valueForKey:@"inputRadius"];
+      if (![current isKindOfClass:[NSNumber class]]) {
+        continue;
+      }
+      if (!*aOriginal) {
+        *aOriginal = [current retain];
+      }
+      NSNumber* wanted = aRadius >= 0 ? @(aRadius) : *aOriginal;
+      if (![current isEqualToNumber:wanted]) {
+        [filter setValue:wanted forKey:@"inputRadius"];
+        changed = true;
+      }
+    }
+    if (changed) {
+      // Filters are copied into the render tree on assignment, so the edited
+      // array has to be handed back for the change to reach the screen.
+      aLayer.filters = filters;
+    }
+    return;
+  }
+  for (CALayer* sublayer in aLayer.sublayers) {
+    ZenApplyBackdropBlurRadius(sublayer, aSkip, aRadius, aOriginal,
+                               aDepth + 1);
+  }
+}
