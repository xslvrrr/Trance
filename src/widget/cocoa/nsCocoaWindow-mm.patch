+// >>> TRANCE
+// The material is a continuous compositor effect: macOS keeps resolving it for
+// a window that is minimised, fully occluded or behind another application,
+// and for a machine in Low Power Mode that is work nobody asked for. AppKit
+// exposes the switch as NSVisualEffectStateInactive, which stops the effect
+// without taking the view down and without a relayout when it comes back.
+//
+// The power-mode half is a process-wide fact, so it is mirrored into a default
+// -branch pref rather than read per view: one notification observer for the
+// process, and the existing pref-callback path is what wakes every live view.
+static constexpr const char* kZenLowPowerModePref =
+    "zen.performance.low-power-mode";
+
+static void ZenUpdateLowPowerModePref() {
+  bool enabled = false;
+  if (@available(macOS 12.0, *)) {
+    enabled = NSProcessInfo.processInfo.lowPowerModeEnabled;
+  }
+  Preferences::SetBool(kZenLowPowerModePref, enabled, PrefValueKind::Default);
+}
