   void SetColorSchemeOverride(mozilla::dom::PrefersColorSchemeOverride);
 
+  // Zen boosts override. SVG images render in their own document, which has no
+  // BrowsingContext to carry the page's boost, so the host propagates it here.
+  void SetZenBoostsOverride(nscolor aAccent, float aComplementaryRotation,
+                            bool aInverted) {
+    mZenBoostsOverrideAccent = aAccent;
+    mZenBoostsOverrideComplementaryRotation = aComplementaryRotation;
+    mZenBoostsOverrideInverted = aInverted;
+    mHasZenBoostsOverride = true;
+    // >>> TRANCE
+    // An override is the whole answer for this document, so it also settles
+    // the fast path below: there is no BrowsingContext here to ask instead.
+    mZenBoostsActivity = (aAccent || aInverted) ? ZenBoostsActivity::Active
+                                                : ZenBoostsActivity::Inactive;
+    // <<< TRANCE
+  }
+  bool HasZenBoostsOverride() const { return mHasZenBoostsOverride; }
+  nscolor ZenBoostsOverrideAccent() const { return mZenBoostsOverrideAccent; }
+  float ZenBoostsOverrideComplementaryRotation() const {
+    return mZenBoostsOverrideComplementaryRotation;
+  }
+  bool ZenBoostsOverrideInverted() const { return mZenBoostsOverrideInverted; }
+
+  // >>> TRANCE
+  // The fast path for nsZenBoostsBackend::ResolveStyleColor, which runs for
+  // every style colour in every document and, on an unboosted page, did all of
+  // its work only to conclude that there was no boost: Document ->
+  // BrowsingContext -> Top(), plus a walk of the frame's native-anonymous
+  // ancestry, per colour.
+  //
+  // Tri-state rather than a bool, because a PresContext can be built for a
+  // BrowsingContext that already carries a boost. A cross-process navigation
+  // replicates the BrowsingContext's fields into the new content process
+  // without firing DidSet, and ZenBoostsChild then re-applies the same value,
+  // which is not a change either — so a bool defaulting to false would read
+  // "no boosts" in exactly the case where there are some. `Unresolved` means
+  // "ask the top BrowsingContext once, then cache the answer"; the DidSet
+  // handlers in nsZenBCOverrides.cpp overwrite the cache on every change.
+  //
+  // AUDIT.md Phase 4.
+  enum class ZenBoostsActivity : uint8_t { Unresolved = 0, Inactive, Active };
+  ZenBoostsActivity GetZenBoostsActivity() const { return mZenBoostsActivity; }
+  void SetZenBoostsActivity(ZenBoostsActivity aActivity) {
+    mZenBoostsActivity = aActivity;
+  }
+  // <<< TRANCE
+
