# === Icons (TRANCE.md §3.8) ===
#
# Not an icon *set*. Trance ships no packs any more (ADR-039) — what is left is
# the handful of glyphs Trance's own UI needs and the browser has none of: the
# theme picker's palette, heart and add buttons.
#
# Real files, one copy each, referenced by chrome:// URL — not inlined as data
# URIs, which is how the four mods this replaces managed to ship the same
# padlock four times and cache it never.
#
# Wildcards: jarmaker expands `*` against the source directory and joins each
# match onto the trailing-slash destination (mozbuild/jar.py), so adding a glyph
# needs no packaging change.

        content/browser/trance-icons/ (../../zen/trance/icons/*.svg)

# === Images (TRANCE.md §6.6) ===
#
# The two pictures Trance ships a *default* for, so that a fresh profile shows
# the intended browser rather than an empty file picker: the chrome's background
# texture and the empty-tab mark. Both prefs take any URL, so choosing your own
# replaces these rather than layering on them.
#
# `topo.png` is downscaled to 1600px on its long edge. The original is
# 20833×12500 and 4.7MB; it is painted at 15% opacity behind an 8px blur, so
# every pixel past about 1600 is a megabyte spent on detail the blur removes.
#
# `wave-light.png` is sameerasw's, from github.com/sameerasw/my-internet, and is
# recorded in docs/trance/THIRD-PARTY.md.

        content/browser/trance-images/ (../../zen/trance/images/*.png)

# === Settings (about:preferences#trance) ===
#
# These land in the same browser.jar paths that browser/components/preferences/
# jar.mn uses, so the settings pane needs no second packaging touchpoint.

        content/browser/preferences/trance-settings.js                          (../../zen/trance/settings/trance-settings.js)
        content/browser/trance-styles/trance-settings.css                       (../../zen/trance/settings/trance-settings.css)

# Sine's own pane, in the same palette. Its own file because it is the one
# Trance stylesheet allowed `!important` — it has to answer a third party's,
# which is a different argument from the ban in TRANCE.md §6.2 rule 1. Loaded
# with the document, not with the Trance pane.

        content/browser/trance-styles/trance-sine.css                           (../../zen/trance/settings/trance-sine.css)

# The mod guard annotates Sine/Cosine's own panes, so it loads with the
# document rather than with the Trance pane. Its stylesheet is injected from
# JS only when a card needs a banner (TRANCE.md §6.5).

        content/browser/preferences/trance-mod-guard.js                         (../../zen/trance/settings/trance-mod-guard.js)
        content/browser/trance-styles/trance-mod-guard.css                      (../../zen/trance/settings/trance-mod-guard.css)
