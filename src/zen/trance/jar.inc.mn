#
# Trance: packaging map. Included from
# src/browser/base/content/zen-assets.jar.inc.mn, which browser/base/jar.mn
# pulls into browser.jar. Paths are relative to browser/base.
#
# A leading `*` marks a file for preprocessing. Nothing here needs it yet.
#
# Refs: TRANCE.md §5.3

# === Foundation layer (TRANCE.md §6) ===

        content/browser/trance-components/TranceCore.mjs                        (../../zen/trance/core/TranceCore.mjs)
        content/browser/trance-components/TranceLog.mjs                         (../../zen/trance/core/TranceLog.mjs)
        content/browser/trance-components/TranceScheduler.mjs                   (../../zen/trance/core/TranceScheduler.mjs)
        content/browser/trance-components/TranceObserverHub.mjs                 (../../zen/trance/core/TranceObserverHub.mjs)
        content/browser/trance-components/TranceStyles.mjs                      (../../zen/trance/core/TranceStyles.mjs)
        content/browser/trance-components/TranceTokens.mjs                      (../../zen/trance/core/TranceTokens.mjs)
        content/browser/trance-components/TranceMotion.mjs                      (../../zen/trance/core/TranceMotion.mjs)
        content/browser/trance-components/TranceIcons.mjs                       (../../zen/trance/core/TranceIcons.mjs)
        content/browser/trance-components/TranceFeature.mjs                     (../../zen/trance/core/TranceFeature.mjs)

        content/browser/trance-styles/trance.css                                (../../zen/trance/styles/trance.css)
        content/browser/trance-styles/trance-tokens.css                         (../../zen/trance/styles/trance-tokens.css)
        content/browser/trance-styles/trance-reset.css                          (../../zen/trance/styles/trance-reset.css)
        content/browser/trance-styles/trance-motion.css                         (../../zen/trance/styles/trance-motion.css)

# === Features ===

        content/browser/trance-components/TranceSurfaces.mjs                    (../../zen/trance/features/surfaces/TranceSurfaces.mjs)
        content/browser/trance-styles/trance-surfaces.css                       (../../zen/trance/styles/trance-surfaces.css)

        content/browser/trance-components/TranceTabStrip.mjs                    (../../zen/trance/features/tabstrip/TranceTabStrip.mjs)
        content/browser/trance-styles/trance-tabstrip.css                       (../../zen/trance/styles/trance-tabstrip.css)

        content/browser/trance-components/TranceChrome.mjs                      (../../zen/trance/features/chrome/TranceChrome.mjs)
        content/browser/trance-styles/trance-chrome.css                         (../../zen/trance/styles/trance-chrome.css)

        content/browser/trance-components/TranceFeedback.mjs                    (../../zen/trance/features/feedback/TranceFeedback.mjs)
        content/browser/trance-styles/trance-feedback.css                       (../../zen/trance/styles/trance-feedback.css)

# The two icon mapping sheets are generated by scripts/trance-icons.py. Exactly
# one is loaded at a time — TranceChrome swaps them when the pack pref changes,
# so the pack you are not using is not in the style set at all.

        content/browser/trance-styles/trance-icons-fluent.css                   (../../zen/trance/styles/trance-icons-fluent.css)
        content/browser/trance-styles/trance-icons-zen.css                      (../../zen/trance/styles/trance-icons-zen.css)

# === Icons (TRANCE.md §3.8) ===
#
# Real files, one copy each, referenced by chrome:// URL — not inlined as data
# URIs, which is how the four mods this replaces managed to ship the same
# padlock four times and cache it never.
#
# Wildcards: jarmaker expands `*` against the source directory and joins each
# match onto the trailing-slash destination (mozbuild/jar.py). Two lines beat
# 284, and adding a glyph then needs no packaging change.

        content/browser/trance-icons/fluent/ (../../zen/trance/icons/fluent/*.svg)
        content/browser/trance-icons/zen/    (../../zen/trance/icons/zen/*.svg)

# === Settings (about:preferences#trance) ===
#
# These land in the same browser.jar paths that browser/components/preferences/
# jar.mn uses, so the settings pane needs no second packaging touchpoint.

        content/browser/preferences/trance-settings.js                          (../../zen/trance/settings/trance-settings.js)
        content/browser/trance-styles/trance-settings.css                       (../../zen/trance/settings/trance-settings.css)

# The mod guard annotates Sine/Cosine's own panes, so it loads with the
# document rather than with the Trance pane. Its stylesheet is injected from
# JS only when a card needs a banner (TRANCE.md §6.5).

        content/browser/preferences/trance-mod-guard.js                         (../../zen/trance/settings/trance-mod-guard.js)
        content/browser/trance-styles/trance-mod-guard.css                      (../../zen/trance/settings/trance-mod-guard.css)
